#!/bin/bash
set -e
set -o pipefail

# Applications: {{ output "ls" (joinPath .chezmoi.homeDir "Applications") | replace "\n" " " }}

icon_folder="${HOME}/.local/share/icons"

{{ if ne .chassisType "container" }}
while IFS= read -r -d '' appimage_path; do
    chmod +x "$appimage_path"

    appimage_filename=$(basename "$appimage_path")
    app_name="${appimage_filename%.AppImage}"
    desktop_path="${HOME}/.local/share/applications/$app_name.desktop"

    chmod +x "$appimage_path"

    # skip if desktop entry already exists
    [ -f "$desktop_path" ] && continue

    tempdir=$(mktemp -d)

    pushd "$tempdir" >/dev/null
    "$appimage_path" --appimage-extract > /dev/null
    cd squashfs-root/

    # prefer the icon referenced by .DirIcon (only when it's a symlink, so we
    # get a real file extension), otherwise fall back to any png/svg
    icon_src=""
    [ -L .DirIcon ] && icon_src=$(readlink -f .DirIcon)
    if [ -z "$icon_src" ] || [ ! -f "$icon_src" ]; then
        icon_src=$(find -L . -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.svg' \) | head -n1 || true)
    fi

    icon_dst=""
    if [ -n "$icon_src" ]; then
        icon_ext="${icon_src##*.}"
        icon_dst="${icon_folder}/$app_name.$icon_ext"
        cp "$icon_src" "$icon_dst"
    fi

    # reuse the AppImage's embedded desktop entry for correct Name,
    # StartupWMClass, Categories, etc., rewriting only Exec and Icon
    internal_desktop=$(find -L . -maxdepth 1 -name '*.desktop' | head -n1 || true)
    if [ -n "$internal_desktop" ]; then
        # preserve the field code (%U, %F, ...) from the embedded Exec line
        field_code=$(grep -m1 '^Exec=' "$internal_desktop" | grep -oE '%[a-zA-Z]' | head -n1 || true)
        exec_line="Exec=\"$appimage_path\"${field_code:+ $field_code}"
        sed -E \
            -e "s|^Exec=.*|$exec_line|" \
            -e "s|^Icon=.*|Icon=$icon_dst|" \
            "$internal_desktop" > "$desktop_path"
    else
cat <<EOT > "$desktop_path"
[Desktop Entry]
Name=$app_name
StartupWMClass=$app_name
Exec="$appimage_path"
Icon=$icon_dst
Type=Application
Terminal=false
EOT
    fi

    popd >/dev/null
    rm -rf "$tempdir"

    echo "Created desktop entry for $app_name"

done < <(find "$HOME/Applications" -name '*.AppImage' -print0)

# clean up desktop entries for AppImages that no longer exist
for desktop_path in "${HOME}/.local/share/applications/"*.desktop; do
    [ -f "$desktop_path" ] || continue

    exec_line=$(grep -m1 '^Exec=' "$desktop_path" | sed 's/^Exec=//')
    if [[ "$exec_line" =~ ^\"([^\"]+)\" ]]; then
        desktop_appimage_path="${BASH_REMATCH[1]}"
    else
        desktop_appimage_path="${exec_line%% *}"
    fi

    # only consider entries pointing at an AppImage under ~/Applications
    case "$desktop_appimage_path" in
        "$HOME/Applications/"*.AppImage) ;;
        *) continue ;;
    esac

    # keep the entry if the AppImage still exists
    [ -f "$desktop_appimage_path" ] && continue

    icon_path=$(grep -m1 '^Icon=' "$desktop_path" | sed 's/^Icon=//')
    rm -f "$desktop_path"
    [ -n "$icon_path" ] && rm -f "$icon_path"

    echo "Removed stale desktop entry $(basename "$desktop_path")"
done

{{ end }}
