#!/bin/bash

# unit file hashes:
{{- range list "*.service" "*.timer" "*.socket" "*.target" }}
{{- range glob (joinPath $.chezmoi.sourceDir "dot_config/systemd/user" .) }}
# {{ include . | sha256sum }}
{{- end }}
{{- end }}

sudo systemctl daemon-reload
sleep 3
{{ range .units.system -}}
sudo systemctl enable --now {{ . }} || true
{{ end -}}

systemctl --user daemon-reload
sleep 3
{{ range .units.user_base }}
{{- if hasPrefix "gitforgefs@" . }}
# restarting gitforgefs would probably fail (if the fs is in use), so we settle on just enabling it
systemctl --user enable --now {{ . }} || true
{{- else }}
systemctl --user enable {{ . }} || true
systemctl --user restart {{ . }} || true
{{- end }}
{{ end }}

{{ if ne .chassisType "container" }}
{{ range .units.user_desktop -}}
systemctl --user enable {{ . }} || true
systemctl --user restart {{ . }} || true
{{ end }}
{{ end }}
