{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- /* setValueAtPath mutates $config, so serialize it first */ -}}
{{- $before := toPrettyJson $config -}}
{{- $after := $config
    | setValueAtPath (list "shortcuts" "core:actions.show") "mod+p"
    | setValueAtPath "plugins.relays.enabled" false
    /* we have to use a hack to disable session naming */
    | setValueAtPath "sessionNaming.model" "disabled/disabled"
    | toPrettyJson -}}
{{- if eq $before $after -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   $after | trimSuffix "\n" -}}
{{- end -}}
