version: 1

landlock:
  compatibility: best_effort

filesystem_policy:
  include_workdir: true
  read_only:
    - /usr
    - /lib
    - /etc
    - /opt
    - /proc
    - /dev/urandom
    - /var/log
    - /AGENTS.md
    - {{ .chezmoi.homeDir }}/.pi/agent/extensions
    - {{ .chezmoi.homeDir }}/.gitconfig
  read_write:
    - /tmp
    - /dev/null
    - {{ .chezmoi.homeDir }}/develop
    - {{ .chezmoi.homeDir }}/.local/share/chezmoi
    - {{ .chezmoi.homeDir }}/.pi
    - {{ .chezmoi.homeDir }}/.cache
    - {{ .chezmoi.homeDir }}/.claude
    - {{ .chezmoi.homeDir }}/.claude.json
    # --unsafe-host-wayland and --unsafe-enable-docker
    - /run/user/{{ .chezmoi.uid }}
    - /pibox-docker

network_policies:
  databricks:
    endpoints:
      - host: "**.azuredatabricks.net"
        port: 443
        allowed_ips: [10.0.0.0/8]
    binaries:
      - { path: /usr/bin/node }
  badjware.dev:
    endpoints:
      - host: genai.badjware.dev
        port: 443
    binaries:
      - { path: /usr/bin/node }
  internet:
    endpoints:
      - { host: "agents.md", port: 443 }
      - { host: "api.github.com", port: 443 }
      - { host: "api.nuget.org", port: 443 }
      - { host: "code.badjware.dev", port: 443 }
      - { host: "code.claude.com", port: 443 }
      - { host: "developer.chrome.com", port: 443 }
      - { host: "developers.openai.com", port: 443 }
      - { host: "docs.anthropic.com", port: 443 }
      - { host: "docs.aws.amazon.com", port: 443 }
      - { host: "docs.claude.com", port: 443 }
      - { host: "docs.databricks.com", port: 443 }
      - { host: "docs.docker.com", port: 443 }
      - { host: "docs.gitlab.com", port: 443 }
      - { host: "docs.litellm.ai", port: 443 }
      - { host: "docs.nextcloud.com", port: 443 }
      - { host: "docs.nvidia.com", port: 443 }
      - { host: "docs.obsidian.md", port: 443 }
      - { host: "docs.openwebui.com", port: 443 }
      - { host: "docs.pipewire.org", port: 443 }
      - { host: "docs.python.org", port: 443 }
