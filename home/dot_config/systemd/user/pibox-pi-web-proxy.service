[Unit]
Description=pibox pi-web socket proxy
BindsTo=pibox-pi-web.socket
# Wants rather than BindsTo: the proxy must accept connections even when the container can't start, otherwise the socket retriggers in a loop
Wants=pibox-pi-web.service
After=pibox-pi-web.socket pibox-pi-web.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18504
