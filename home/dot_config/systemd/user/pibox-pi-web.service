[Unit]
Description=pibox pi-web container
# retry forever so pi-web comes back on its own once docker is up again
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/develop
# pi-web rejects API requests whose Host header is not loopback, an IP, or in PI_WEB_ALLOWED_HOSTS
ExecStart=%h/.local/bin/pibox --pull --harness pi-web --env PI_WEB_ALLOWED_HOSTS=pi-pallet.badjware.dev --volume %h/.local/share/chezmoi:%h/.local/share/chezmoi:rw
TimeoutStartSec=300
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
