[Unit]
Description=pibox pi-web container
# retry forever so pi-web comes back on its own once docker is up again
StartLimitIntervalSec=0

[Service]
Environment=PIBOX_PI_WEB_PORT=8504
WorkingDirectory=%h/develop
# pi-web hardcodes fastify per-request logging at info level, so we drop those lines here
ExecStart=/bin/bash -c 'set -o pipefail; %h/.local/bin/pibox --pull --harness pi-web --volume %h/.local/share/chezmoi:%h/.local/share/chezmoi:rw | /usr/bin/rg --line-buffered -v "msg.:.(incoming request|request completed)."'
TimeoutStartSec=300
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
