#!/bin/bash

primary="$(~/.local/bin/sway-primary-output)"

# animated lockscreens drain the battery
if ! grep -qs Discharging /sys/class/power_supply/BAT*/status; then
    if which swaylock-plugin &>/dev/null; then
        if which mpvpaper &>/dev/null && [[ "$MPVPAPER_VIDEO_PATH" =~ ^https?:// || -e "$MPVPAPER_VIDEO_PATH" ]]; then
            animated_command="mpvpaper --mpv-option 'no-audio loop $MPVPAPER_OPTION --quiet --panscan=1' 'ALL' -- '$MPVPAPER_VIDEO_PATH'"
            swaylock_command="if [ \"\$SWAYLOCK_PLUGIN_OUTPUT_NAME\" = '$primary' ]; then exec $animated_command; else exec swaybg -c 000000; fi"
        fi
    fi
fi

if [[ -n "$swaylock_command" ]]; then
    swaylock-plugin "$@" --command-each "$swaylock_command" -d
else
    swaylock "$@"
fi
