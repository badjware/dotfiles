#!/usr/bin/env bash

usage_file="$(find /sys/devices -name gpu_busy_percent -print -quit)"
[[ -n "$usage_file" ]] || exit 0

device="$(dirname "$usage_file")"
[[ -r "$device/mem_info_vram_used" && -r "$device/mem_info_vram_total" ]] || exit 0

usage=$(<"$usage_file")
vram_used_bytes=$(numfmt --format="%0.1f" --to=iec-i <"$device/mem_info_vram_used")B
vram_total_bytes=$(numfmt --format="%0.1f" --to=iec-i <"$device/mem_info_vram_total")B

jq -c -n --arg text "$usage%" --arg tooltip "VRAM: $vram_used_bytes/$vram_total_bytes" --arg class "gpu" \
    --argjson percentage "$usage" \
    '{text: $text, percentage: $percentage, tooltip: $tooltip, class: $class}'