{{- /* chezmoi:modify-template */ -}}
{{- $now := dateInZone "2006-01-02T15:04:05.000Z" now "UTC" -}}
{{- $defaults := list
  (dict "id" "a606255e-f71f-416a-b97b-34b378a59502" "name" "chezmoi" "path" (joinPath .chezmoi.homeDir ".local/share/chezmoi") "createdAt" $now)
  (dict "id" "87f8e776-7ed7-4dab-81ad-40ea766fa4e8" "name" "pibox" "path" (joinPath .chezmoi.homeDir "develop/github.com/badjware/pibox") "createdAt" $now) -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $projects := get $config "projects" | default list -}}
{{- $ids := list -}}
{{- range $projects -}}
{{-   $ids = append $ids .id -}}
{{- end -}}
{{- $missing := list -}}
{{- range $defaults -}}
{{-   if not (has .id $ids) -}}
{{-     $missing = append $missing . -}}
{{-   end -}}
{{- end -}}
{{- if $missing -}}
{{-   $config | setValueAtPath "projects" (concat $projects $missing) | toPrettyJson -}}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
